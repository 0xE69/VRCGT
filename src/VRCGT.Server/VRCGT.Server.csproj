<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\VRCGT.Core\VRCGT.Core.csproj" />
    <ProjectReference Include="..\VRCGT.Infrastructure\VRCGT.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0-alpha.1</Version>
    <Product>VRCGT</Product>
    <Copyright>Copyright © VRCGT Contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Front-end build integration
    ===========================
    Automatically builds the VRCGT.Web React app before the .NET build so that
    wwwroot/ is always up-to-date when running `dotnet build` or `dotnet run`.

    Skip with:  dotnet build /p:SkipWebFrontend=true
    This is useful when iterating on backend-only changes to avoid the npm overhead.

    The npm install step only runs when node_modules is absent (fresh clone / CI).
  -->
  <Target Name="NpmInstall"
          BeforeTargets="BuildWebFrontend"
          Condition="'$(SkipWebFrontend)' != 'true'
                     And Exists('$(MSBuildThisFileDirectory)..\VRCGT.Web\package.json')
                     And !Exists('$(MSBuildThisFileDirectory)..\VRCGT.Web\node_modules')">
    <Message Text="[VRCGT.Web] Installing npm dependencies…" Importance="high" />
    <Exec Command="npm install --prefer-offline"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\VRCGT.Web" />
  </Target>

  <Target Name="BuildWebFrontend"
          BeforeTargets="Build"
          Condition="'$(SkipWebFrontend)' != 'true'
                     And Exists('$(MSBuildThisFileDirectory)..\VRCGT.Web\package.json')">
    <Message Text="[VRCGT.Web] Building React frontend → wwwroot/" Importance="high" />
    <Exec Command="npm run build"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\VRCGT.Web" />
  </Target>

</Project>
