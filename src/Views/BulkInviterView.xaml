<UserControl x:Class="VRCGroupTools.Views.BulkInviterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:VRCGroupTools.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:BulkInviterViewModel}"
             mc:Ignorable="d"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="📋 Bulk Group Inviter"
                       FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Paste a list or import a text file of VRChat user IDs, apply filters, and send invites in one run."
                       Foreground="#888" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Import + filters panel -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="16" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- Left: user ID list -->
                <Grid Grid.Column="0" Margin="0,0,15,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="User ID list" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ParsedIdCount, StringFormat='  ({0} IDs)'}"
                                   Foreground="#7C4DFF" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Button Command="{Binding LoadFromFileCommand}"
                                Margin="12,0,0,0" Padding="10,5" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#2A2A2A" CornerRadius="4"
                                            BorderBrush="#444" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1F1F1F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="📂 Load File" Foreground="#DDD" FontSize="12" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding UserIdsText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#121212" Foreground="#DDD"
                             BorderBrush="#333" BorderThickness="1"
                             Padding="8" FontFamily="Consolas" FontSize="12"
                             materialDesign:HintAssist.Hint="One user ID per line (or click Load File), e.g.
usr-1234abcd
usr-5678efgh"/>

                    <TextBlock Grid.Row="2" Text="IDs can be separated by new lines, commas, or spaces. Duplicates are removed automatically."
                               Foreground="#666" FontSize="11" Margin="0,6,0,0"/>
                </Grid>

                <!-- Right: filters + run -->
                <Border Grid.Column="1" Background="#121212" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Filters" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <CheckBox Content="Skip already invited (DB)"
                                  IsChecked="{Binding SkipAlreadyInvited}"
                                  Foreground="#DDD" Margin="0,0,0,8"/>
                        <CheckBox Content="Only invite 18+ verified"
                                  IsChecked="{Binding Only18Plus}"
                                  Foreground="#DDD" Margin="0,0,0,8"/>
                        <CheckBox Content="Skip new users"
                                  IsChecked="{Binding SkipNewUsers}"
                                  Foreground="#DDD" Margin="0,0,0,8"/>
                        <CheckBox Content="Skip users"
                                  IsChecked="{Binding SkipUsers}"
                                  Foreground="#DDD" Margin="0,0,0,8"/>
                        <CheckBox Content="Skip known users"
                                  IsChecked="{Binding SkipKnown}"
                                  Foreground="#DDD" Margin="0,0,0,12"/>

                        <Button Command="{Binding RunBulkCommand}"
                                Height="44" Margin="0,4,0,0"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Background" Value="#7C4DFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="#4A4A4A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Run Bulk Invite"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Text" Value="Inviting..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#AAA" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Summary bar -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="14" Margin="0,0,0,15"
                Visibility="{Binding SummaryText, Converter={StaticResource EmptyStringToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SummaryText}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Results grid -->
        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8" Padding="12">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#2A2A2A"
                      Background="Transparent"
                      Foreground="#DDD"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#161616"
                      BorderThickness="0"
                      CanUserAddRows="False"
                      FontSize="12">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#121212"/>
                        <Setter Property="Foreground" Value="#BBB"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#2A2A2A"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#DDD"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="180"/>
                    <DataGridTextColumn Header="Trust Level" Binding="{Binding TrustLevel}" Width="120"/>
                    <DataGridTextColumn Header="18+" Binding="{Binding IsAgeVerified}" Width="50"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding OutcomeDisplay}" Width="110"/>
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
