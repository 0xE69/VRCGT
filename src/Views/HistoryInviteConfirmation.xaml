<Window x:Class="VRCGroupTools.Views.HistoryInviteConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="650" Height="480" WindowStartupLocation="CenterOwner"
        Background="#252526" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="ReviewText" IsReadOnly="True" Style="{x:Null}"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" Foreground="White" BorderThickness="0"
                 FontSize="14" Padding="0,0,10,0"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="ConfirmButton" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
