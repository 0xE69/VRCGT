<Window x:Class="VRCGroupTools.Views.PublicationApprovalWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Explicit approval — ONE VRChat publication" Width="820" Height="800" MinWidth="550" MinHeight="400"
 WindowStartupLocation="CenterScreen" Background="#202024" Foreground="White">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <TextBlock Text="Each external effect is tracked durably. Partial success is retained; unknown outcomes are never retried. Requested notifications are not delivery-confirmed." TextWrapping="Wrap"/>
   <CheckBox x:Name="Reviewed" Foreground="White" Content="I reviewed this exact account, group, action, content, artwork, audience, notification choice and UTC event dates." Margin="0,12"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel — send nothing" IsCancel="True" Padding="14,8" Margin="0,0,12,0"/>
    <Button x:Name="Approve" Content="Approve this ONE publication now" IsEnabled="{Binding IsChecked, ElementName=Reviewed}" Padding="14,8" Click="Approve_Click"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="Exact preview — no automatic or combined posting" FontSize="21" FontWeight="Bold" Margin="0,0,0,12"/>
    <Image x:Name="Artwork" MaxHeight="350" Stretch="Uniform" Margin="0,0,0,12"/>
    <TextBox x:Name="ExactPreview" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#29292F" Foreground="White" BorderBrush="#555" Padding="12"/>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
