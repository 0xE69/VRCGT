# ============================================================
# VRCGT — .gitignore
# ============================================================

# ── Copilot / dev audit documents ────────────────────────────
# These are AI-generated development artifacts, not product files.
*_AUDIT.md
*_REPORT.md
*_INVENTORY.md
*_CHECKLIST.md
ALPHA_RELEASE_NOTES.md
CLEANUP_GENERATED_FILES.md
FEATURE_PARITY_V1_TO_V2.md
RUNTIME_SMOKE_TEST.md
TESTING.md
UI_REDESIGN_REQUIREMENTS.md
WEB_LOCAL_APP_MIGRATION_PLAN.md

# ── .NET build outputs ───────────────────────────────────────
bin/
obj/
TestResults/
*.user
*.suo
*.userosscache
*.rsuser
*.sln.docstates
*.nupkg
*.snupkg
project.lock.json

# ── NuGet (restored automatically; lock file IS tracked) ─────
packages/

# ── Publish / release artifacts ──────────────────────────────
artifacts/
[Pp]ublish/
out/
Release/
release/
releases/
dist-release/
src/bin/Release/
src/bin/Publish/

# ── Archive and installer outputs ────────────────────────────
*.zip
*.tar.gz
*.7z
*.msi
installer/Output/

# ── Frontend — build outputs and tooling ─────────────────────
node_modules/
src/VRCGT.Web/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
coverage/

# ── Local application data (runtime-created) ─────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
settings.json
Cache/
cache/
Logs/
logs/
CrashReports/
crashreports/
exports/
backups/

# ── Secrets and local developer config ───────────────────────
# NOTE: appsettings.json and appsettings.Development.json are
# intentional source files and are NOT ignored.
# Only local developer overrides are excluded here:
appsettings.Local.json
appsettings.Development.local.json
appsettings.*.local.json
secrets.json

# Environment variables — .env.example IS tracked
.env
.env.*
!.env.example

# VRChat credentials and session data
Secure/
secure/
auth_cookie.txt
session.json
credentials.enc
*.enc
*.pem
*.key
*.cred
*.cookie
*.cookies
*.token
*_token.txt
*_session.txt
auth_*.txt
auth_*.json

# Discord / webhook secrets
webhook*.txt
discord_*.json

# ── IDE and editors ───────────────────────────────────────────
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# ── OS generated ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Misc generated / temporary ───────────────────────────────
*.log
*.bak
*.backup
*.tmp
*.temp
~$*
user_data/
userdata/
UserData/
*_test.json
*_debug.json
captcha_*.png
captcha_*.jpg
captcha_*.gif
captcha/
hcaptcha/
recaptcha/
